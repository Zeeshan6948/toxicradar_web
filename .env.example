# ==========================================
# ToxicRadar Environment Configuration
# ==========================================

# OpenAI API Key (Required for message toxicity analysis)
OPENAI_API_KEY=sk-...

# Server Port (Optional, Render provides PORT automatically)
PORT=3000

# Optional App Password (If deploying to public URL and you want access gated)
# APP_PASSWORD=

# ==========================================
# Firebase Persistent Storage (Task 1: Render Inactivity Fix)
# ==========================================
# Get these from your Firebase Console (Project Settings -> General)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=AIzaSy...

# Optional: Set this if using Firebase Realtime Database instead of Cloud Firestore
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Optional: Prefix for collections / paths (defaults to "toxicradar")
# FIREBASE_COLLECTION_PREFIX=toxicradar

